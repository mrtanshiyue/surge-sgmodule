#!name=截图 App 去广告聚合（完整上游版）
#!desc=聚合截图中有可用 Surge 上游模块的完整规则、重写、Map Local、脚本和 MITM。建议 Surge iOS 5.102.0；需启用 Rewrite、MITM 与 Scripting。
#!author=mrtanshiyue + upstream rule authors
#!homepage=https://github.com/mrtanshiyue/surge-sgmodule

# Generated from pinned upstream snapshots; see README.md, sources.json and THIRD_PARTY_NOTICES.txt.
# All rules are inline in [Rule]; no [Ruleset] section or module-wide CORE_VERSION gate is used.

[Rule]
# 京东
URL-REGEX,"^http:\/\/\w{32}\.jddebug\.com\/diagnose\?",REJECT,extended-matching
# 淘宝
