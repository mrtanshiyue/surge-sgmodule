#!name=个人 App 去广告聚合 · 原生版
#!desc=精选广告规则；需要 Surge iOS 5.23.0+（目前为 TestFlight RC）并启用 Rewrite 与 MITM。静态规则快照，未做手机实测。
#!author=个人聚合整理；规则来源 fmz200/奶思、可莉、RuCu6、QingRex、ddgksf2013/Walvez、app2smile、Blackmatrix7、R-Store
#!requirement="CORE_VERSION>=6010000 && SYSTEM=='iOS'"

# Version: 0.3.2 / 2026-10-19
# Sources and limitations: see 使用说明.md and 来源与验证.md
# Derived rules retain original attribution; see THIRD_PARTY_NOTICES.txt.
# All-in-one local snapshot. Does not fetch executable scripts.

[Rule]
RULE-SET,PersonalAds20261019,REJECT,pre-matching

